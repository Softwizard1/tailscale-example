# -----------------------------------------------------------------------------
# Copy this file to ".env" and fill in your values. .env is gitignored.
#
# 1. Create a Tailscale account (free) at https://login.tailscale.com
# 2. Apply the ACL policy in policy.hujson FIRST (Admin console → Access controls)
#    so that tag:backend / tag:client / tag:dev exist and are owned by you.
# 3. Create a *reusable, ephemeral* auth key with those tags authorized:
#    Admin console → Settings → Keys → Generate auth key
#      - Reusable:  ON   (so all three nodes can use the same key)
#      - Ephemeral: ON   (nodes auto-remove when stopped → clean re-runs)
#      - Tags:      tag:backend, tag:client, tag:dev
# -----------------------------------------------------------------------------
TS_AUTHKEY=tskey-auth-abskdgkhsdgh
